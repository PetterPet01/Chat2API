# DeepSeek browser/web token copied from an authenticated chat.deepseek.com session.
DEEPSEEK_AUTH_TOKEN=

# Optional client-facing API key for /v1/* (recommended outside localhost).
API_KEY=

# Management API key for /v0/management/* and the dashboard's API calls.
# If omitted, management falls back to API_KEY. Configure one of them before exposing management.
MANAGEMENT_API_KEY=

# Managed-token store and routing behavior.
TOKENS_FILE=deepseek_tokens.json
ROTATION_STRATEGY=fill_first
TOKEN_HEALTH_CHECK_INTERVAL_SECONDS=300
TOKEN_FAILURE_COOLDOWN_SECONDS=300

# Disabled by default. When enabled, clients may send X-DeepSeek-Token.
ALLOW_REQUEST_TOKEN=false

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Remote images are limited to public HTTP(S) hosts by default.
ALLOW_PRIVATE_IMAGE_URLS=false
MAX_IMAGE_BYTES=104857600
MAX_IMAGES=10
DELETE_SESSIONS=true
